{
  "name": "trustvault",
  "version": "1.0.0",
  "description": "TrustVault — Secure document sharing platform with cryptographic tamper-evident audit trail",
  "private": true,
  "scripts": {
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/src/server.js",
    "migrate:pg": "tsx server/src/db/migrate.ts",
    "seed:pg": "tsx server/src/db/seed.pg.ts",
    "seed": "tsx server/src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:verify": "tsx server/src/scripts/verifyAuditChain.ts"
  },
  "keywords": [
    "security",
    "audit-trail",
    "zero-trust",
    "tamper-evident",
    "rbac",
    "document-vault"
  ],
  "author": "TrustVault Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
